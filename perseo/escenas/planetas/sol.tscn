[sub_resource type="Shader" id="Shader_fqfkk"]
code = "
shader_type spatial;
render_mode unshaded;

uniform sampler2D tex_color : source_color;
uniform sampler2D tex_ruido : repeat_enable;

uniform vec3 col_centro : source_color = vec3(1.0, 0.98, 0.7);
uniform vec3 col_medio1 : source_color = vec3(1.0, 0.35, 0.1);
uniform vec3 col_medio2 : source_color = vec3(0.95, 0.1, 0.65);
uniform vec3 col_borde  : source_color = vec3(0.05, 0.45, 1.0);

uniform float influencia_textura = 0.65;
uniform float distorsion_fluida = 0.25;
uniform float grano_risografia = 0.10;
uniform float brillo_superficie = 0.85;
uniform float intensidad_halo = 0.6;
uniform float grosor_halo = 3.5;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

void fragment() {
	vec3 tex_base = texture(tex_color, UV).rgb;
	float mapa_superficie = dot(tex_base, vec3(0.299, 0.587, 0.114));
	float n_fluido = texture(tex_ruido, UV * 3.0 + vec2(TIME * 0.015, 0.0)).r;
	
	vec3 dir_luz_falsa = normalize(vec3(-0.5, 0.5, 0.7));
	float luz_esfera = clamp(dot(NORMAL, dir_luz_falsa) * 0.5 + 0.5, 0.0, 1.0);
	float ndotv = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
	
	float base_gradiente = mix(luz_esfera * ndotv, mapa_superficie, influencia_textura);
	float banda = clamp(base_gradiente + (n_fluido - 0.5) * distorsion_fluida, 0.0, 1.0);
	
	float grano = (hash(FRAGCOORD.xy * 0.5 + UV * 500.0) - 0.5) * grano_risografia;
	float b = clamp(banda + grano, 0.0, 1.0);
	
	vec3 color_final = col_borde;
	color_final = mix(color_final, col_medio2, smoothstep(0.12, 0.38, b));
	color_final = mix(color_final, col_medio1, smoothstep(0.38, 0.65, b));
	color_final = mix(color_final, col_centro, smoothstep(0.65, 0.88, b));
	
	float rim = pow(1.0 - ndotv, grosor_halo);
	ALBEDO = (color_final * brillo_superficie) + (col_borde * rim * intensidad_halo);
}
"

